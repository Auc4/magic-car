        "type": "function",
        "z": "a1f0c0de00000001",
        "name": "JSON → CSV",
        "func": "let d;\ntry {\n    d = JSON.parse(msg.payload);\n} catch (e) {\n    return null;\n}\n\nconst lim = (v, min, max) => Math.max(min, Math.min(max, Math.round(Number(v) || 0)));\nconst mask = (Number(d.b) >>> 0);\n\n// Extrae los 16 botones en el orden exacto que espera el ESP32:\n// 0:X, 1:Circulo, 2:Cuadrado, 3:Triangulo, 4:L1, 5:R1, 6:L2(btn), 7:R2(btn),\n// 8:Share, 9:Options, 10:L3, 11:R3, 12:Arriba, 13:Abajo, 14:Izquierda, 15:Derecha\nconst botones = [];\nfor (let i = 0; i < 16; i++) {\n    botones.push((mask >>> i) & 1);\n}\n\nconst campos = [\n    lim(d.lx, -100, 100),\n    lim(d.ly, -100, 100),\n    lim(d.rx, -100, 100),\n    lim(d.ry, -100, 100),\n    lim(d.l2, 0, 100),\n    lim(d.r2, 0, 100),\n    ...botones\n];\n\nmsg.payload = campos.join(',');\n\nconst ahora = Date.now();\nif (ahora - (context.get('t') || 0) > 250) {\n    node.status({ fill: 'green', shape: 'dot', text: msg.payload });\n    context.set('t', ahora);\n}\nreturn msg;",
